{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blog-pro/faq",
  "title": "FAQ",
  "icon": "editor-help",
  "category": "widgets",
  "description": "Accordion of frequently asked questions.",
  "keywords": ["faq", "question", "accordion"],
  "textdomain": "blog-pro",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./style.css",
  "render": "file:./render.php",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Frequently Asked Questions"
    },
    "items": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "openFirst": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  }
}
